APP_MODE=offline
APP_ORIGIN=http://localhost:3000
PORT=3000
DATABASE_URL=postgresql://self_review:local_dev@localhost:55432/self_review
REDIS_URL=redis://localhost:56379/0
REDIS_PREFIX=self-review:
