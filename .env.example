AUTH_SECRET=
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=Self Review <no-reply@self-review.local>
MAIL_DELIVERY=local
