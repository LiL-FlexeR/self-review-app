{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"rootDir": "src",
		"outDir": "dist",
		"paths": {
			"@app/*": ["./src/*.ts"]
		},
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"types": ["node"]
	},
	"include": ["src/**/*.ts"],
	"exclude": ["src/**/*.test.ts"],
	"tsc-alias": {
		"resolveFullPaths": true,
		"resolveFullExtension": ".js"
	}
}
