APP_MODE=offline
LOG_LEVEL=info
# For APP_MODE=demo, configure OPENAI_API_KEY in backend/.env.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
APP_ORIGIN=http://localhost:3000
# Optional Compose host port; its internal API port stays 3000.
# APP_PORT=3000
# API port for host development.
PORT=3000
DATABASE_URL=postgresql://self_review:local_dev@localhost:55432/self_review
REDIS_URL=redis://localhost:56379/0
REDIS_PREFIX=self-review:
# Generate three independent values; never commit backend/.env.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=Self Review <no-reply@self-review.local>
MAIL_DELIVERY=local
# Optional external delivery; MAIL_DELIVERY=external
# SMTP_USER=
# SMTP_PASSWORD=
